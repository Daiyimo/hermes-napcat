# ============================================================
# Hermes-NapCat Adapter — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored at runtime.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   hermes gateway setup   # or set env vars manually before starting
# ============================================================


# ── Required ─────────────────────────────────────────────────

# NapCat HTTP API base URL (no trailing slash).
# Enable "HTTP Server" in NapCat network settings (default port 3000).
NAPCAT_HTTP_URL=http://127.0.0.1:3000

# NapCat WebSocket URL (no trailing slash).
# Forward mode (default): address of NapCat WS Server, e.g. ws://127.0.0.1:3001
# Reverse mode:           address the adapter listens on, e.g. ws://0.0.0.0:3002
NAPCAT_WS_URL=ws://127.0.0.1:3001


# ── Connection mode ──────────────────────────────────────────

# WebSocket connection direction.
#   forward  — adapter connects TO NapCat (websocketServers, default)
#   reverse  — NapCat connects TO adapter (websocketClients / reverse proxy)
NAPCAT_WS_MODE=forward


# ── Authentication ───────────────────────────────────────────

# Optional Bearer token.  Must match the "token" field in your NapCat
# HTTP/WS Server config.  Leave empty if no token is configured.
NAPCAT_TOKEN=


# ── Access control ───────────────────────────────────────────

# Comma-separated QQ numbers allowed to send private messages to the bot.
# Leave empty to allow all users (equivalent to NAPCAT_ALLOW_ALL_USERS=true).
NAPCAT_ALLOWED_USERS=

# Comma-separated QQ numbers allowed to @-trigger the bot in group chats.
# Leave empty to allow all group members.
NAPCAT_GROUP_ALLOWED_USERS=

# Set to "true" to explicitly open the bot to all users (private chat).
# Overridden by NAPCAT_ALLOWED_USERS if that list is non-empty.
NAPCAT_ALLOW_ALL_USERS=false


# ── Admin commands ───────────────────────────────────────────

# Comma-separated QQ numbers that may use admin commands:
# /mute, /unmute, /kick, /ban, /status, /help
NAPCAT_ADMIN_USERS=


# ── Behaviour tweaks ─────────────────────────────────────────

# Require the bot to be @-mentioned before responding in group chats.
# Set to "false" to respond to every group message (noisy — use with caution).
# Default: true
NAPCAT_REQUIRE_MENTION=true

# Send emoji reactions (👍 / 😡) on the triggering message to signal
# processing state.  Set to "false" to disable all emoji reactions.
# Default: true
NAPCAT_ENABLE_REACTIONS=true

# Quote (reply-to) behaviour when the bot responds.
#   off    — never quote the incoming message (default, cleaner output)
#   first  — quote only the first message chunk
#   all    — quote every message chunk
# Default: off
NAPCAT_REPLY_MODE=off


# ── Scheduling / proactive messages ──────────────────────────

# Default delivery target for scheduled tasks and proactive notifications.
# Private chat: bare QQ number, e.g. 123456789
# Group chat:   prefix with "g:", e.g. g:987654321
# Leave empty to disable proactive delivery.
NAPCAT_HOME_CHANNEL=


# ── Hermes internals ─────────────────────────────────────────

# Directory used to cache downloaded media files (images, voice, etc.)
# before they are forwarded to the LLM.
# Default: /tmp/hermes_cache
HERMES_CACHE_DIR=/tmp/hermes_cache
