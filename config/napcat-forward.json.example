{
  "network": {
    "httpServers": [
      {
        "name": "hermesHttp",
        "enable": true,
        "port": 3000,
        "host": "0.0.0.0",
        "messagePostFormat": "array",
        "token": ""
      }
    ],
    "websocketServers": [
      {
        "name": "hermesWs",
        "enable": true,
        "host": "0.0.0.0",
        "port": 3001,
        "messagePostFormat": "array",
        "reportSelfMessage": false,
        "token": "",
        "heartInterval": 30000
      }
    ]
  }
}
