+    allowed = prompt("  允许私聊的 QQ 号（逗号分隔，留空则不限制）", password=False)
+    if allowed:
+        save_env_value("NAPCAT_ALLOWED_USERS", allowed.replace(" ", ""))
+        print_success("  已保存 NAPCAT_ALLOWED_USERS — 仅白名单内的用户可私聊使用")
