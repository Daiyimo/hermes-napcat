+        print_warning("  已跳过 — 缺少 HTTP 地址，NapCat 将无法正常工作。")
+        return
+    save_env_value("NAPCAT_HTTP_URL", http_url.strip().rstrip("/"))
+    print_success("  已保存 NAPCAT_HTTP_URL")
+
+    # ── 必填：WebSocket 地址 ──
