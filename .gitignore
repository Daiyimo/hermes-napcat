# =============================================================================
# hermes-napcat — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python bytecode & caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
wheels/
sdist/
MANIFEST
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env.bak

# -----------------------------------------------------------------------------
# Environment variables & secrets  ← NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example          # keep the example template
*.secret
secrets.yaml
secrets.json

# -----------------------------------------------------------------------------
# Testing & coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
nosetests.xml
test-results/

# -----------------------------------------------------------------------------
# Type checking & linting
# -----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# -----------------------------------------------------------------------------
# IDE / editor
# -----------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, IntelliJ …)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------------------------------------------------------------------
# Logs & runtime artefacts
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
log_*.txt

# hermes / napcat runtime cache
hermes_cache/
.hermes/
napcat_cache/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
# Local NapCat config snapshots (may contain tokens / QQ numbers)
onebot11_*.json

# Patched gateway files — generated by install.sh, not part of this repo
napcat_gateway.patch.applied

# Shell script download cache (used by install.sh)
hermes-napcat-install-*.sh
